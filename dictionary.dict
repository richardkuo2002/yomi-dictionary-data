{"i":"jm1470990","k":["波及"],"r":["はきゅう"],"s":[{"p":"n,vs,vi","e":"spread; extension; influence; aftereffect; ripple","z":"波及、擴散","zs":"subagent"}],"f":49.89325,"l":"","u":0,"x":["台風の被害は、ほかの町にも波及しました。","台風(たいふう)の被害(ひがい)は、ほかの町(まち)にも波及(はきゅう)しました。","颱風的災情也波及到其他城鎮。","a"]}
{"i":"jm1471000","k":["波止場","波戸場"],"r":["はとば"],"s":[{"p":"n","e":"wharf; quay; landing-stage; jetty","z":"碼頭","zs":"subagent"}],"f":49.89324,"l":"","u":0,"x":["夕方、波止場で船を見ていました。","夕方(ゆうがた)、波止場(はとば)で船(ふね)を見(み)ていました。","傍晚我在碼頭看船。","a"]}
{"i":"jm1471060","k":["波長"],"r":["はちょう"],"s":[{"p":"n","e":"wavelength","z":"波長","zs":"subagent"}],"f":49.89323,"l":"","u":0,"x":["光は色によって波長がちがいます。","光(ひかり)は色(いろ)によって波長(はちょう)がちがいます。","光依顏色不同,波長也不同。","a"]}
{"i":"jm1471090","k":["波紋"],"r":["はもん"],"s":[{"p":"n","e":"ripple; ring on the water","z":"漣漪、水波","zs":"subagent"},{"p":"n","e":"repercussions","z":"影響、波瀾","zs":"subagent"},{"p":"n","e":"Japanese slit drum; instrument made of iron with slits on top; makes a rippling sound","z":"日本的鐵製狹縫鼓","zs":"subagent"}],"f":49.89322,"l":"","u":0,"x":["石を投げると、水に波紋が広がります。","石(いし)を投(な)げると、水(みず)に波紋(はもん)が広(ひろ)がります。","丟石頭下去,水面就會擴散出漣漪。","a"]}
{"i":"jm1471100","k":["波浪"],"r":["はろう"],"s":[{"p":"n","e":"waves; billows; surge","z":"波浪","zs":"subagent"}],"f":49.89321,"l":"","u":0,"x":["波浪が高いので、船は出ません。","波浪(はろう)が高(たか)いので、船(ふね)は出(で)ません。","因為浪很高,船不開出去。","a"]}
{"i":"jm1471110","k":["波乱万丈","波瀾万丈","波乱バンジョー"],"r":["はらんばんじょう"],"s":[{"p":"adj-no,adj-na,n","e":"stormy and full of drama; full of ups and downs; with many vicissitudes","z":"起伏跌宕、充滿波折","zs":"subagent"}],"f":49.8932,"l":"","u":0,"x":["祖母は波乱万丈の人生を送りました。","祖母(そぼ)は波乱万丈(はらんばんじょう)の人生(じんせい)を送(おく)りました。","祖母度過了波瀾萬丈的一生。","a"]}
{"i":"jm1471120","k":["派"],"r":["は"],"s":[{"p":"n,n-suf","e":"group; faction; clique; coterie","z":"派別、團體","zs":"subagent"},{"p":"n,n-suf","e":"(political) faction; wing; camp","z":"派系、陣營","zs":"subagent"},{"p":"n,n-suf","e":"school (of thought, painting, etc.)","z":"學派、流派","zs":"subagent"},{"p":"n,n-suf","e":"sect; denomination","z":"宗派、教派","zs":"subagent"}],"f":49.89319,"l":"","u":0,"x":["私はコーヒーより紅茶派です。","私(わたし)はコーヒーより紅茶(こうちゃ)派(は)です。","比起咖啡,我是紅茶派。","a"]}
{"i":"jm1471150","k":["派生"],"r":["はせい"],"s":[{"p":"n,vs,vt,vi","e":"derivation; development; offshoot","z":"衍生","zs":"subagent"}],"f":49.89318,"l":"","u":0,"x":["この言葉は、古い言葉から派生しました。","この言葉(ことば)は、古(ふる)い言葉(ことば)から派生(はせい)しました。","這個詞是從古老的詞衍生出來的。","a"]}
{"i":"jm1471180","k":["派閥"],"r":["はばつ"],"s":[{"p":"n,adj-no","e":"clique; faction","z":"派系","zs":"subagent"}],"f":49.89317,"l":"","u":0,"x":["会社の中には、いくつかの派閥があります。","会社(かいしゃ)の中(なか)には、いくつかの派閥(はばつ)があります。","公司裡有好幾個派系。","a"]}
{"i":"jm1471290","k":["破格"],"r":["はかく"],"s":[{"p":"adj-no,adj-na,n","e":"extraordinary; exceptional; unprecedented; special; abnormal; irregular","z":"破格、異常","zs":"subagent"},{"p":"adj-no,adj-na,n","e":"solecistic; non-standard; irregular","z":"不合規範的、不規則的","zs":"subagent"}],"f":49.89316,"l":"","u":0,"x":["この店は破格の安さで有名です。","この店(みせ)は破格(はかく)の安(やす)さで有名(ゆうめい)です。","這家店以破格的低價聞名。","a"]}
{"i":"jm1471310","k":["破局"],"r":["はきょく"],"s":[{"p":"n","e":"catastrophe; cataclysm","z":"災難性的結局、崩潰","zs":"subagent"},{"p":"n,vs,vi","e":"collapse (of a relationship); breakup; split (friends, lovers, etc.)","z":"關係破裂、分手","zs":"subagent"}],"f":49.89315,"l":"","u":0,"x":["二人は結婚の前に破局しました。","二人(ふたり)は結婚(けっこん)の前(まえ)に破局(はきょく)しました。","兩人在結婚前分手了。","a"]}
{"i":"jm1471390","k":["破綻","破たん"],"r":["はたん"],"s":[{"p":"n,vs,vi","e":"failure; collapse; breakdown; break-up; bankruptcy","z":"破產、失敗、崩潰","zs":"subagent"},{"p":"n,vs,vi","e":"tear (in clothing, etc.); rip; split","z":"綻線、裂開","zs":"subagent"}],"f":49.89314,"l":"","u":0,"x":["計画が破綻して、みんな困りました。","計画(けいかく)が破綻(はたん)して、みんな困(こま)りました。","計畫失敗了,大家都很困擾。","a"]}
{"i":"jm1471430","k":["破滅"],"r":["はめつ"],"s":[{"p":"n,vs,vi","e":"ruin; destruction; fall","z":"毀滅、滅亡","zs":"subagent"}],"f":49.89313,"l":"","u":0,"x":["ギャンブルで身を破滅させた人もいます。","ギャンブルで身(み)を破滅(はめつ)させた人(ひと)もいます。","也有人因為賭博而毀了自己。","a"]}
{"i":"jm1471780","k":["馬車"],"r":["ばしゃ","うまぐるま"],"s":[{"p":"n","e":"coach (horse-drawn); carriage; wagon; cart","z":"馬車","zs":"subagent"}],"f":49.89312,"l":"","u":0,"x":["公園で、子どもたちが馬車に乗っています。","公園(こうえん)で、子(こ)どもたちが馬車(ばしゃ)に乗(の)っています。","孩子們在公園裡乘坐馬車。","a"]}
{"i":"jm1471790","k":["馬術"],"r":["ばじゅつ"],"s":[{"p":"n","e":"horsemanship; equestrian art; (art of) riding","z":"馬術","zs":"subagent"}],"f":49.89311,"l":"","u":0,"x":["姉は大学で馬術を習っています。","姉(あね)は大学(だいがく)で馬術(ばじゅつ)を習(なら)っています。","姊姊在大學學馬術。","a"]}
{"i":"jm1471870","k":["馬力"],"r":["ばりき"],"s":[{"p":"n","e":"horsepower; hp","z":"馬力","zs":"subagent"},{"p":"n","e":"energy; vitality; vigour; strength","z":"幹勁、精力","zs":"subagent"},{"p":"n","e":"horse-drawn cart","z":"馬拉的車","zs":"subagent"}],"f":49.8931,"l":"","u":0,"x":["彼は馬力があって、一日中働けます。","彼(かれ)は馬力(ばりき)があって、一日中(いちにちじゅう)働(はたら)けます。","他精力充沛,可以工作一整天。","a"]}
{"i":"jm1471920","k":["俳人"],"r":["はいじん"],"s":[{"p":"n","e":"haiku poet","z":"俳句詩人","zs":"subagent"}],"f":49.89309,"l":"","u":0,"x":["祖父は俳人で、毎日俳句を作ります。","祖父(そふ)は俳人(はいじん)で、毎日(まいにち)俳句(はいく)を作(つく)ります。","祖父是俳句詩人,每天都作俳句。","a"]}
{"i":"jm1472040","k":["廃棄物"],"r":["はいきぶつ"],"s":[{"p":"n","e":"waste matter; waste; garbage; trash","z":"廢棄物","zs":"subagent"}],"f":49.89308,"l":"","u":0,"x":["工場から出る廃棄物は、きちんと処理します。","工場(こうじょう)から出(で)る廃棄物(はいきぶつ)は、きちんと処理(しょり)します。","工廠排出的廢棄物會妥善處理。","a"]}
{"i":"jm1472050","k":["廃墟","廃虚"],"r":["はいきょ"],"s":[{"p":"n","e":"ruins (of a building, town, etc.); remains","z":"廢墟","zs":"subagent"}],"f":49.89307,"l":"","u":0,"x":["山の中に古い廃墟が残っています。","山(やま)の中(なか)に古(ふる)い廃墟(はいきょ)が残(のこ)っています。","山裡留有古老的廢墟。","a"]}
{"i":"jm1472060","k":["廃業"],"r":["はいぎょう"],"s":[{"p":"n,vs,vt,vi","e":"discontinuation (of business); closing down; giving up (one's practice); retiring","z":"歇業、停業","zs":"subagent"}],"f":49.89306,"l":"","u":0,"x":["父の店は去年、廃業しました。","父(ちち)の店(みせ)は去年(きょねん)、廃業(はいぎょう)しました。","爸爸的店去年歇業了。","a"]}
{"i":"jm1472070","k":["廃坑","廃鉱"],"r":["はいこう"],"s":[{"p":"n,vs,vi","e":"closure of a mine; abandoned mine; disused mine","z":"廢礦坑","zs":"subagent"}],"f":49.89305,"l":"","u":0,"x":["町の近くに、昔の廃坑があります。","町(まち)の近(ちか)くに、昔(むかし)の廃坑(はいこう)があります。","城鎮附近有以前的廢礦坑。","a"]}
{"i":"jm1472090","k":["廃材"],"r":["はいざい"],"s":[{"p":"n","e":"scrap wood; waste wood","z":"廢木材","zs":"subagent"},{"p":"n","e":"waste; waste material; scrap material","z":"廢料、廢材","zs":"subagent"}],"f":49.89304,"l":"","u":0,"x":["廃材を使って、小さな本棚を作りました。","廃材(はいざい)を使(つか)って、小(ちい)さな本棚(ほんだな)を作(つく)りました。","我用廢木材做了一個小書架。","a"]}
{"i":"jm1472150","k":["廃絶"],"r":["はいぜつ"],"s":[{"p":"n,vs,vt","e":"abolition; elimination","z":"廢除、根絕","zs":"subagent"},{"p":"n,vs,vi","e":"extinction; discontinuation","z":"絕種、中斷","zs":"subagent"}],"f":49.89303,"l":"","u":0,"x":["病気を廃絶するために、世界中が協力しています。","病気(びょうき)を廃絶(はいぜつ)するために、世界中(せかいじゅう)が協力(きょうりょく)しています。","全世界為了根絕疾病而合作。","a"]}
