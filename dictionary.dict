{"i":"jm1329190","k":["酒類"],"r":["しゅるい","さけるい"],"s":[{"p":"n","e":"alcoholic drinks; liquor","z":"酒類","zs":"subagent"}],"f":49.92263,"l":"","u":0,"x":["この店は酒類を売っていません。","この店(みせ)は酒類(しゅるい)を売(う)っていません。","這家店不賣酒類。","a"]}
{"i":"jm1329320","k":["首長"],"r":["しゅちょう"],"s":[{"p":"n","e":"head (of organization, organisation); chief","z":"首長、領導人","zs":"subagent"},{"p":"n","e":"sheikh; emir","z":"酋長、埃米爾","zs":"subagent"}],"f":49.92262,"l":"","u":0,"x":["市の首長が会議で話しました。","市(し)の首長(しゅちょう)が会議(かいぎ)で話(はな)しました。","市長在會議上發言了。","a"]}
{"i":"jm1329350","k":["首都圏"],"r":["しゅとけん"],"s":[{"p":"n","e":"Greater Tokyo Metropolitan area","z":"東京都會區","zs":"subagent"},{"p":"n","e":"metropolitan area (of a capital)","z":"首都圈","zs":"subagent"}],"f":49.92261,"l":"","u":0,"x":["首都圏には人が多く住んでいます。","首都圏(しゅとけん)には人(ひと)が多(おお)く住(す)んでいます。","首都圈住著很多人。","a"]}
{"i":"jm1329380","k":["首班"],"r":["しゅはん"],"s":[{"p":"n","e":"head; leader; prime minister","z":"首相、首領","zs":"subagent"}],"f":49.9226,"l":"","u":0,"x":["新しい内閣の首班が決まりました。","新(あたら)しい内閣(ないかく)の首班(しゅはん)が決(き)まりました。","新內閣的首相確定了。","a"]}
{"i":"jm1329390","k":["首尾"],"r":["しゅび"],"s":[{"p":"n","e":"beginning and end; from beginning to end","z":"始末、從頭到尾","zs":"subagent"},{"p":"n","e":"result; outcome; course of events","z":"結果、經過","zs":"subagent"},{"p":"n,vs","e":"dealing with something successfully","z":"順利完成","zs":"subagent"}],"f":49.92259,"l":"","u":0,"x":["計画は首尾よく進みました。","計画(けいかく)は首尾(しゅび)よく進(すす)みました。","計畫進行得很順利。","a"]}
{"i":"jm1329420","k":["首謀","主謀"],"r":["しゅぼう"],"s":[{"p":"n","e":"plotting; planning (crime, intrigue)","z":"策劃","zs":"subagent"},{"p":"n","e":"ringleader; mastermind; leader (of a plot)","z":"主謀、首腦","zs":"subagent"}],"f":49.92258,"l":"","u":0,"x":["警察は首謀者を探しています。","警察(けいさつ)は首謀者(しゅぼうしゃ)を探(さが)しています。","警方正在尋找主謀。","a"]}
{"i":"jm1329470","k":["儒学"],"r":["じゅがく"],"s":[{"p":"n","e":"Confucianism","z":"儒學","zs":"subagent"}],"f":49.92257,"l":"","u":0,"x":["兄は大学で儒学を勉強しています。","兄(あに)は大学(だいがく)で儒学(じゅがく)を勉強(べんきょう)しています。","哥哥在大學研讀儒學。","a"]}
{"i":"jm1329510","k":["儒教"],"r":["じゅきょう"],"s":[{"p":"n","e":"Confucianism","z":"儒教","zs":"subagent"}],"f":49.92256,"l":"","u":0,"x":["儒教は中国で生まれた教えです。","儒教(じゅきょう)は中国(ちゅうごく)で生(う)まれた教(おし)えです。","儒教是誕生於中國的教導。","a"]}
{"i":"jm1329620","k":["受け皿","受皿"],"r":["うけざら"],"s":[{"p":"n","e":"saucer","z":"茶碟、盤子","zs":"subagent"},{"p":"n","e":"person (group, institution, etc.) to take over a position or matter; receptacle (e.g. of funds); receiver","z":"承接者、容納的地方","zs":"subagent"}],"f":49.92255,"l":"","u":0,"x":["カップを受け皿にのせました。","カップを受(う)け皿(ざら)にのせました。","我把杯子放在碟子上。","a"]}
{"i":"jm1329720","k":["受刑"],"r":["じゅけい"],"s":[{"p":"n,vs,vi","e":"punishment","z":"服刑","zs":"subagent"}],"f":49.92254,"l":"","u":0,"x":["彼は今、刑務所で受刑しています。","彼(かれ)は今(いま)、刑務所(けいむしょ)で受刑(じゅけい)しています。","他現在正在監獄服刑。","a"]}
{"i":"jm1329760","k":["受講"],"r":["じゅこう"],"s":[{"p":"n,vs,vt,vi","e":"taking a lecture; attending a class; taking a course","z":"聽課、上課","zs":"subagent"}],"f":49.92253,"l":"","u":0,"x":["来月から英語の講座を受講します。","来月(らいげつ)から英語(えいご)の講座(こうざ)を受講(じゅこう)します。","我下個月開始要上英語課程。","a"]}
{"i":"jm1329790","k":["受賞"],"r":["じゅしょう"],"s":[{"p":"n,vs,vt,vi","e":"winning a prize; receiving an award; being awarded","z":"得獎","zs":"subagent"}],"f":49.92252,"l":"","u":0,"x":["彼女は小説で文学賞を受賞しました。","彼女(かのじょ)は小説(しょうせつ)で文学賞(ぶんがくしょう)を受賞(じゅしょう)しました。","她憑小說獲得了文學獎。","a"]}
{"i":"jm1329810","k":["受信"],"r":["じゅしん"],"s":[{"p":"n,vs,vt","e":"receiving (a message, letter, email, etc.); reception (radio, TV, etc.)","z":"接收、收信","zs":"subagent"}],"f":49.92251,"l":"","u":0,"x":["新しいメールを受信しました。","新(あたら)しいメールを受信(じゅしん)しました。","我收到了新郵件。","a"]}
{"i":"jm1329830","k":["受信機","受信器"],"r":["じゅしんき"],"s":[{"p":"n","e":"(television, radio, etc.) receiver","z":"接收器、收音機","zs":"subagent"}],"f":49.9225,"l":"","u":0,"x":["古い受信機でラジオを聞きます。","古(ふる)い受信機(じゅしんき)でラジオを聞(き)きます。","我用舊的接收機聽廣播。","a"]}
{"i":"jm1329880","k":["受精卵"],"r":["じゅせいらん"],"s":[{"p":"n","e":"fertilized egg; fertilised egg","z":"受精卵","zs":"subagent"}],"f":49.92249,"l":"","u":0,"x":["受精卵は少しずつ大きくなります。","受精卵(じゅせいらん)は少(すこ)しずつ大(おお)きくなります。","受精卵會一點一點長大。","a"]}
{"i":"jm1329900","k":["受像"],"r":["じゅぞう"],"s":[{"p":"n,vs,vt","e":"(television) reception; receiving (a picture)","z":"電視接收、接收影像","zs":"subagent"}],"f":49.92248,"l":"","u":0,"x":["山の中は受像が悪いです。","山(やま)の中(なか)は受像(じゅぞう)が悪(わる)いです。","山裡的電視收訊不好。","a"]}
{"i":"jm1329920","k":["受胎"],"r":["じゅたい"],"s":[{"p":"n,vs,vi","e":"conception; fertilization; fertilisation","z":"受孕、懷孕","zs":"subagent"}],"f":49.92247,"l":"","u":0,"x":["受胎の仕組みを本で調べました。","受胎(じゅたい)の仕組(しく)みを本(ほん)で調(しら)べました。","我從書上查了受孕的原理。","a"]}
{"i":"jm1329930","k":["受託"],"r":["じゅたく"],"s":[{"p":"n,vs,vt","e":"being entrusted with; taking charge of","z":"受託、接受委託","zs":"subagent"}],"f":49.92246,"l":"","u":0,"x":["会社は大きな仕事を受託しました。","会社(かいしゃ)は大(おお)きな仕事(しごと)を受託(じゅたく)しました。","公司接下了一項大工作。","a"]}
{"i":"jm1329960","k":["受諾"],"r":["じゅだく"],"s":[{"p":"n,vs,vt","e":"acceptance","z":"接受、答應","zs":"subagent"}],"f":49.92245,"l":"","u":0,"x":["彼は私たちの申し出を受諾しました。","彼(かれ)は私(わたし)たちの申(もう)し出(で)を受諾(じゅだく)しました。","他接受了我們的提議。","a"]}
{"i":"jm1329970","k":["受注","受註"],"r":["じゅちゅう"],"s":[{"p":"n,vs,vt","e":"accepting an order; receiving an order; orders received; closed won","z":"接單、接受訂單","zs":"subagent"}],"f":49.92244,"l":"","u":0,"x":["工場は新しい注文を受注しました。","工場(こうじょう)は新(あたら)しい注文(ちゅうもん)を受注(じゅちゅう)しました。","工廠接到了新的訂單。","a"]}
{"i":"jm1329990","k":["受動"],"r":["じゅどう"],"s":[{"p":"n,adj-no","e":"passivity; passiveness","z":"被動","zs":"subagent"},{"p":"n","e":"passivity; (the) passive","z":"被動語態","zs":"subagent"}],"f":49.92243,"l":"","u":0,"x":["受動の形を文法の授業で習いました。","受動(じゅどう)の形(かたち)を文法(ぶんぽう)の授業(じゅぎょう)で習(なら)いました。","我在文法課學了被動的形式。","a"]}
{"i":"jm1330010","k":["受動的"],"r":["じゅどうてき"],"s":[{"p":"adj-na","e":"passive","z":"被動的","zs":"subagent"}],"f":49.92242,"l":"","u":0,"x":["受動的な態度では成長できません。","受動的(じゅどうてき)な態度(たいど)では成長(せいちょう)できません。","抱持被動的態度是無法成長的。","a"]}
{"i":"jm1330020","k":["受難"],"r":["じゅなん"],"s":[{"p":"n,vs","e":"sufferings; ordeals; agony","z":"苦難、災難","zs":"subagent"},{"p":"n,vs","e":"Passion (of Christ); crucifixion","z":"基督受難","zs":"subagent"}],"f":49.92241,"l":"","u":0,"x":["今年は受難の年でした。","今年(ことし)は受難(じゅなん)の年(とし)でした。","今年是多災多難的一年。","a"]}
{"i":"jm1330050","k":["受容"],"r":["じゅよう"],"s":[{"p":"n,vs,vt","e":"acceptance; reception","z":"接納、接受","zs":"subagent"}],"f":49.9224,"l":"","u":0,"x":["新しい文化を受容することは大切です。","新(あたら)しい文化(ぶんか)を受容(じゅよう)することは大切(たいせつ)です。","接納新文化很重要。","a"]}
{"i":"jm1330070","k":["受理"],"r":["じゅり"],"s":[{"p":"n,vs,vt","e":"acceptance","z":"受理","zs":"subagent"}],"f":49.92239,"l":"","u":0,"x":["役所は私の申請を受理しました。","役所(やくしょ)は私(わたし)の申請(しんせい)を受理(じゅり)しました。","公家機關受理了我的申請。","a"]}
{"i":"jm1330080","k":["受領"],"r":["じゅりょう"],"s":[{"p":"n,vs,vt","e":"receipt (of a letter, money, etc.); acceptance; receiving","z":"收領、收到","zs":"subagent"}],"f":49.92238,"l":"","u":0,"x":["荷物を確かに受領しました。","荷物(にもつ)を確(たし)かに受領(じゅりょう)しました。","我確實收到了貨物。","a"]}
{"i":"jm1330100","k":["呪い","詛い","咒い"],"r":["のろい"],"s":[{"p":"n","e":"curse; spell; malediction","z":"詛咒","zs":"subagent"}],"f":49.92237,"l":"","u":0,"x":["その人形には呪いがかかっているそうです。","その人形(にんぎょう)には呪(のろ)いがかかっているそうです。","聽說那個娃娃被下了詛咒。","a"]}
{"i":"jm1330120","k":["呪う","詛う"],"r":["のろう"],"s":[{"p":"v5u,vt","e":"to curse; to put a curse on; to detest intensely","z":"詛咒、痛恨","zs":"subagent"}],"f":49.92236,"l":"","u":0,"x":["彼は自分の運の悪さを呪いました。","彼(かれ)は自分(じぶん)の運(うん)の悪(わる)さを呪(のろ)いました。","他詛咒自己的壞運氣。","a"]}
{"i":"jm1330170","k":["寿","壽"],"r":["ことぶき"],"s":[{"p":"n","e":"congratulations; felicitations; best wishes","z":"恭喜、祝賀","zs":"subagent"},{"p":"n","e":"longevity; long life","z":"長壽","zs":"subagent"}],"f":49.92235,"l":"","u":0,"x":["結婚式で寿の文字を見ました。","結婚式(けっこんしき)で寿(ことぶき)の文字(もじ)を見(み)ました。","我在婚禮上看到了「壽」字。","a"]}
{"i":"jm1330270","k":["授かる"],"r":["さずかる"],"s":[{"p":"v5r,vt","e":"to be granted (e.g. a title); to be awarded (e.g. a prize); to be gifted with (a talent); to be blessed with (a child); to be endowed with","z":"被賦予、獲賜","zs":"subagent"},{"p":"v5r,vt","e":"to be taught (e.g. a secret technique); to be instructed; to be initiated","z":"被傳授","zs":"subagent"}],"f":49.92234,"l":"","u":0,"x":["二人は元気な赤ちゃんを授かりました。","二人(ふたり)は元気(げんき)な赤(あか)ちゃんを授(さず)かりました。","兩人喜獲健康的寶寶。","a"]}
{"i":"jm1330310","k":["授業料"],"r":["じゅぎょうりょう"],"s":[{"p":"n","e":"tuition fee; course fee","z":"學費","zs":"subagent"}],"f":49.92233,"l":"","u":0,"x":["大学の授業料は高いです。","大学(だいがく)の授業料(じゅぎょうりょう)は高(たか)いです。","大學的學費很貴。","a"]}
{"i":"jm1330330","k":["授受","受授"],"r":["じゅじゅ"],"s":[{"p":"n,vs,vt","e":"giving and receiving; transferring; transfer; changing hands","z":"授受、交接","zs":"subagent"}],"f":49.92232,"l":"","u":0,"x":["お金の授受は銀行でしてください。","お金(かね)の授受(じゅじゅ)は銀行(ぎんこう)でしてください。","金錢的交付請在銀行辦理。","a"]}
{"i":"jm1330340","k":["授賞"],"r":["じゅしょう"],"s":[{"p":"n,vs,vt,vi","e":"awarding a prize; giving an award","z":"頒獎","zs":"subagent"}],"f":49.92231,"l":"","u":0,"x":["来週、授賞式が行われます。","来週(らいしゅう)、授賞式(じゅしょうしき)が行(おこな)われます。","下週將舉行頒獎典禮。","a"]}
{"i":"jm1330360","k":["授与"],"r":["じゅよ"],"s":[{"p":"n,vs,vt","e":"awarding; conferment; granting; presentation","z":"授予、頒發","zs":"subagent"}],"f":49.9223,"l":"","u":0,"x":["校長先生が卒業生に証書を授与しました。","校長先生(こうちょうせんせい)が卒業生(そつぎょうせい)に証書(しょうしょ)を授与(じゅよ)しました。","校長把證書頒發給畢業生。","a"]}
{"i":"jm1330370","k":["樹脂"],"r":["じゅし"],"s":[{"p":"n,adj-no","e":"resin; rosin","z":"樹脂","zs":"subagent"}],"f":49.92229,"l":"","u":0,"x":["この箱は樹脂でできています。","この箱(はこ)は樹脂(じゅし)でできています。","這個箱子是樹脂做的。","a"]}
{"i":"jm1330380","k":["樹皮"],"r":["じゅひ"],"s":[{"p":"n","e":"bark (of a tree, etc.)","z":"樹皮","zs":"subagent"}],"f":49.92228,"l":"","u":0,"x":["木の樹皮は固いです。","木(き)の樹皮(じゅひ)は固(かた)いです。","樹皮很硬。","a"]}
{"i":"jm1330420","k":["樹齢"],"r":["じゅれい"],"s":[{"p":"n","e":"age of a tree","z":"樹齡","zs":"subagent"}],"f":49.92227,"l":"","u":0,"x":["この木の樹齢は千年です。","この木(き)の樹齢(じゅれい)は千年(せんねん)です。","這棵樹的樹齡有一千年。","a"]}
{"i":"jm1330430","k":["需給"],"r":["じゅきゅう"],"s":[{"p":"n","e":"supply and demand","z":"供需","zs":"subagent"}],"f":49.92226,"l":"","u":0,"x":["需給のバランスが大切です。","需給(じゅきゅう)のバランスが大切(たいせつ)です。","供需的平衡很重要。","a"]}
{"i":"jm1330470","k":["囚人"],"r":["しゅうじん","めしゅうど","めしうど"],"s":[{"p":"n","e":"prisoner; convict","z":"囚犯","zs":"subagent"}],"f":49.92225,"l":"","u":0,"x":["囚人は毎日同じ時間に食事をします。","囚人(しゅうじん)は毎日(まいにち)同(おな)じ時間(じかん)に食事(しょくじ)をします。","囚犯每天在同一時間用餐。","a"]}
{"i":"jm1330660","k":["収拾"],"r":["しゅうしゅう"],"s":[{"p":"n,vs,vt","e":"control; bringing under control; settling (a matter); putting in order","z":"收拾、控制局面","zs":"subagent"}],"f":49.92224,"l":"","u":0,"x":["混乱した場面を収拾するのは難しいです。","混乱(こんらん)した場面(ばめん)を収拾(しゅうしゅう)するのは難(むずか)しいです。","收拾混亂的局面很困難。","a"]}
{"i":"jm1330670","k":["収縮"],"r":["しゅうしゅく"],"s":[{"p":"n,vs,vi","e":"contraction; shrinking; shrinkage; constriction; deflation","z":"收縮","zs":"subagent"}],"f":49.92223,"l":"","u":0,"x":["寒いと筋肉が収縮します。","寒(さむ)いと筋肉(きんにく)が収縮(しゅうしゅく)します。","天冷時肌肉會收縮。","a"]}
{"i":"jm1330830","k":["収納"],"r":["しゅうのう"],"s":[{"p":"n,vs,vt","e":"storage; putting away","z":"收納、收藏","zs":"subagent"},{"p":"n,vs,vt","e":"receipt (of funds, payment, etc.)","z":"收款","zs":"subagent"},{"p":"n,vs,vt","e":"harvesting","z":"收成","zs":"subagent"}],"f":49.92222,"l":"","u":0,"x":["押し入れに布団を収納します。","押(お)し入(い)れに布団(ふとん)を収納(しゅうのう)します。","把棉被收進壁櫥。","a"]}
{"i":"jm1330910","k":["収容所"],"r":["しゅうようじょ"],"s":[{"p":"n","e":"housing facility; detention facility; internment camp; prisoner-of-war camp; concentration camp; refugee camp; asylum","z":"收容所、集中營","zs":"subagent"}],"f":49.92221,"l":"","u":0,"x":["難民は収容所で生活しています。","難民(なんみん)は収容所(しゅうようじょ)で生活(せいかつ)しています。","難民在收容所生活。","a"]}
{"i":"jm1330950","k":["収用"],"r":["しゅうよう"],"s":[{"p":"n,vs,vt","e":"expropriation; seizure","z":"徵收","zs":"subagent"}],"f":49.9222,"l":"","u":0,"x":["道路のために土地が収用されました。","道路(どうろ)のために土地(とち)が収用(しゅうよう)されました。","土地因為道路建設而被徵收。","a"]}
{"i":"jm1330970","k":["収量"],"r":["しゅうりょう"],"s":[{"p":"n","e":"yield; size of harvest","z":"收穫量","zs":"subagent"}],"f":49.92219,"l":"","u":0,"x":["今年は米の収量が多いです。","今年(ことし)は米(こめ)の収量(しゅうりょう)が多(おお)いです。","今年稻米的收穫量很多。","a"]}
{"i":"jm1330980","k":["収録","收錄"],"r":["しゅうろく"],"s":[{"p":"n,vs,vt","e":"recording (in a book, the minutes, etc.); printing; including","z":"收錄","zs":"subagent"},{"p":"n,vs,vt","e":"recording (audio or video)","z":"錄製、錄音","zs":"subagent"}],"f":49.92218,"l":"","u":0,"x":["この本には十の物語が収録されています。","この本(ほん)には十(じゅう)の物語(ものがたり)が収録(しゅうろく)されています。","這本書收錄了十個故事。","a"]}
